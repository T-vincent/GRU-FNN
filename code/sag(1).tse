        }
    }

    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        
        Pnom = 20000.0; 
        Vdc_nominal = 800.0;
        
        Vbreak_on = Vdc_nominal + 150.0
        Vbreak_off = Vdc_nominal 
        break_status_time = 1.0
        
        Rbrk =  Vdc_nominal*Vdc_nominal/(1.0*Pnom)
        
        Vg1rms = 230.0;
        Lg1 = 20e-6;
        Rg1 = 10e-3;
        f1 = 50.0;
        fsw = 10000.0;
        Ilpp = 0.1*Pnom/Vg1rms;
        a = 10.0; # ripple attenuation
        
        ffast = 1.0*fsw
        Tfast = 1.0/ffast
        
        Rdc = Vdc_nominal*Vdc_nominal/Pnom
        
        R1 = Vg1rms*Vg1rms / (500*Pnom) / 3.0; # 0.5% of the loss in inductor
        L1 = 3.0*1.41*Vg1rms / (2*Vdc_nominal) * ((2.0/3.0*Vdc_nominal - 1.41*Vg1rms) / (Ilpp*fsw))
        Cf1 = (a+1)/(4*np.pi*np.pi*fsw*fsw*Lg1)
        C_dc = 100e-10*Pnom
        R_dump = 1.0/(20.0*np.pi*f1*Cf1)*10000.0/Pnom
        
        p = -0.135*10.0;
        i = -0.004/2.0;
        
        Kp_i = 2*L1*fsw*p / Vdc_nominal / 2.0
        Ki_i = 2*L1*fsw*i / Vdc_nominal / 2.0
        
        Tsw = 1/fsw
        
        
        Vg2rms = 230.0;
        Lg2 = 20e-6;
        Rg2 = 10e-3;
        f2 = 50.0;
        fsw2 = 10000.0;
        Il2pp = 0.1*Pnom/Vg2rms;
        a2 = 10.0; # ripple attenuation
        
        R2 = Vg2rms*Vg2rms / (500*Pnom) / 3.0; # 0.5% of the loss in inductor
        L2 = 3.0*1.41*Vg2rms / (2*Vdc_nominal) * ((2.0/3.0*Vdc_nominal - 1.41*Vg2rms) / (Il2pp*fsw2))
        Cf2 = (a2+1)/(4*np.pi*np.pi*fsw2*fsw2*Lg2)
        
        R_dump2 = 1.0/(20.0*np.pi*f2*Cf2)*10000.0/Pnom
        
        Tsw2 = 1/fsw2
        Tslow = 1e-3
        
        p_v = 0.2403
        i_v = 0.0549
        
        # Kp_v = 0.197
        # Ki_v = 0.045
        Kp_v = 4*p_v / (1.5*Vg2rms*1.41*Tslow)
        Ki_v = 4*i_v / (1.5*Vg2rms*1.41*Tslow)
        
        Imax = Pnom/Vg2rms/3.0 * 1.41 * 2.0
    ENDCODE
}
