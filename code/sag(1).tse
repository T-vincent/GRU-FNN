        component "core/C function" Simulink_grid {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            execution_rate = "1e-05"
            global_variables = "uint grid_tick;"
            init_fnc = "/*Begin code section*/
grid_tick=0;
/*End code section*/"
            input_terminals = ""
            input_terminals_dimensions = ""
            input_terminals_feedthrough = ""
            input_terminals_show_labels = ""
            output_fnc = "/*Begin code section*/
real t,pi,w,Vpk;
real sag_percent,sag_start,sag_end;
real scale,theta_a,theta_b,theta_c;

/* ========== 可直接修改的参数 ========== */

/* 基波参数 */
Vpk=311.08519733346361;     /* 基波峰值，对应220 V有效值 */

/* 暂降参数：直接填写百分数 */
sag_percent=40.0;          /* 暂降40%，剩余电压60%；0表示无暂降 */
sag_start=0.2;             /* 暂降开始时间，单位s */
sag_end=0.4;               /* 暂降结束时间，单位s */

/* ========== 以下为计算部分 ========== */

pi=3.141592653589793;
w=2.0*pi*50.0;            /* 基波频率50 Hz */
/* t is time within each 0.6 s cycle: 0 <= t < 0.6. */
t=grid_tick*1e-5;         /* 模块执行周期10 us */

/* 暂降期间的幅值比例，其他时间恢复为1 */
scale=(t>=sag_start && t<sag_end)
      ?(1.0-sag_percent/100.0):1.0;

/* 三相瞬时相角，相差120度 */
theta_a=w*t;
theta_b=w*t-2.0*pi/3.0;
theta_c=w*t+2.0*pi/3.0;

/* 三相电压：不注入谐波 */
va=Vpk*scale*sin(theta_a);
vb=Vpk*scale*sin(theta_b);
vc=Vpk*scale*sin(theta_c);
/*End code section*/"
            output_terminals = "real va;real vb;real vc;"
            output_terminals_dimensions = "(1,);(1,);(1,)"
            output_terminals_feedthrough = "True;True;True"
            output_terminals_show_labels = "False;False;False"
            update_fnc = "/*Begin code section*/
/* 0.6 s repeat period: 60000 ticks at 10 us per tick. */
grid_tick++;
if (grid_tick>=60000) {
    grid_tick=0;
}
/*End code section*/"
        }
